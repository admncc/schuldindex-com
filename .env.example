# Datenbank
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/schulindex

# Basisadresse für die Links in Bestätigungsnachrichten
BASIS_URL=https://schulindex.com

# Freigabe für Suchmaschinen. Ohne den Wert `an` liefert /robots.txt ein
# vollständiges Verbot und jede Seite ein `noindex`. Erst umlegen, wenn
# Bewertungen auch wirklich bestätigt werden können - bis dahin läuft jede
# Besucherin aus einer Trefferliste in eine Sackgasse und verbraucht dabei
# ihren einen Versuch.
INDEXIERUNG=aus

# Schlüssel - je 32 Byte, Base64. Erzeugen mit:
#   head -c32 /dev/urandom | base64 -w0
#
# KONTAKT_HMAC_SCHLUESSEL bildet den Suchhash über Kontaktdaten. Ein Wechsel
# macht alle bestehenden Hashes unbrauchbar und damit die Erkennung von
# Mehrfachkonten blind - vor einem Wechsel muss das Verfahren zum Neuberechnen
# stehen (Entwicklungsplan, Abschnitt 14).
KONTAKT_HMAC_SCHLUESSEL=
# KONTAKT_CHIFFRE_SCHLUESSEL verschlüsselt die Kontaktdaten. Ein Verlust macht
# jedes Konto unerreichbar; ein Wechsel verlangt eine Neuverschlüsselung.
KONTAKT_CHIFFRE_SCHLUESSEL=
# TOKEN_HMAC_SCHLUESSEL sichert die Bestätigungstoken.
TOKEN_HMAC_SCHLUESSEL=
# SITZUNG_HMAC_SCHLUESSEL sichert die Sitzungscookies der Moderation. Ein
# Wechsel meldet alle Moderatorinnen ab - das ist der Notausgang, wenn der
# Verdacht besteht, dass eine Sitzung übernommen wurde.
SITZUNG_HMAC_SCHLUESSEL=

# Der zweite Faktor der Moderation steht nicht hier, sondern im Panel selbst
# (/moderation/einstellungen, Gruppe „Zugang zur Moderation“) - damit ihn die
# Leitung umlegen kann, ohne auf den Server zu müssen, und damit jede Änderung
# im Verlauf steht.

# Wie viele eigene Proxys vor der Anwendung stehen (nginx, Traefik, Load
# Balancer). Ohne diese Angabe werden `X-Forwarded-For` und
# `X-Forwarded-Proto` **nicht ausgewertet**: Beide Kopfzeilen kann der Browser
# selbst setzen, und wer das tut, schaltete sonst die Entfernungsprüfung ab.
# Steht ein Proxy davor, ist der Wert 1; hinter einem CDN entsprechend mehr.
VERTRAUTE_PROXYS=0

# Wo die Kartendaten liegen: das Vektorkachel-Archiv `basis.pmtiles` und die
# Zeichenbilder unter `schriften/`. Fehlt das Archiv, zeigt die Karte ihre
# hintergrundlose Darstellung - kaputt ist nichts. Einrichtung: siehe
# docs/betrieb.md, Abschnitt „Karte".
KARTEN_VERZEICHNIS=daten/karten

# Die GeoIP-Datenbank (MaxMind GeoIP2 City, .mmdb). Ohne sie bleibt der Ort
# jeder Abgabe unbekannt, und die Bewertungen gehen in die Moderation, statt
# ungeprüft durchzugehen. Austauschen lässt sie sich auch im Panel unter
# /moderation/einstellungen.
GEOIP_DB=daten/geoip/GeoIP2-City.mmdb

# Nur für die Einrichtungsskripte: die Rohdatei des Schulbestands.
#   npx tsx scripts/lade-schulen.ts > schulen.json
#   SCHULEN_JSON=schulen.json npx tsx scripts/importiere.ts
#   SCHULEN_JSON=schulen.json npx tsx scripts/abgleich.ts
SCHULEN_JSON=schulen.json

# Claude API für die Freitext-Zusammenfassungen (Entwicklungsplan, Abschnitt 10.2).
# Ohne Schlüssel läuft alles außer dem Aufruf selbst; der Job bricht dann ab.
ANTHROPIC_API_KEY=

# Angaben zum Betreiber. Ohne sie bleiben Impressum und Datenschutzerklärung
# unvollständig - die Seiten sagen das dann selbst und deutlich.
BETREIBER_NAME=
BETREIBER_RECHTSFORM=
BETREIBER_STRASSE=
BETREIBER_PLZ=
BETREIBER_ORT=
BETREIBER_VERTRETEN=
BETREIBER_REGISTER=
BETREIBER_REGISTERNUMMER=
BETREIBER_USTID=
BETREIBER_EMAIL=
BETREIBER_TELEFON=
# § 18 Abs. 2 MStV - bei redaktionellen Angeboten Pflicht
BETREIBER_VERANTWORTLICH=
BETREIBER_DATENSCHUTZBEAUFTRAGTER=
BETREIBER_HOSTER=
BETREIBER_PROTOKOLLFRIST=
# Verarbeitungsregion der Claude API, wie im Auftragsverarbeitungsvertrag
# festgelegt (Entwicklungsplan, Abschnitt 10.2)
KI_VERARBEITUNGSREGION=
